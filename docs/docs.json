{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Notare",
  "colors": {
    "primary": "#74540F",
    "light": "#946F25",
    "dark": "#5D430D"
  },
  "favicon": "/favicon.svg",
  "seo": {
    "metatags": {
      "canonical": "https://docs.notare.dev"
    }
  },
  "navigation": {
    "pages": [
      {
        "group": "Getting started",
        "pages": ["index", "quickstart"]
      },
      {
        "group": "Using Notare",
        "pages": ["meetings", "notes", "chat", "calendar", "ai-setup", "sync"]
      },
      {
        "group": "CLI and agents",
        "pages": [
          "installation",
          "agents/overview",
          "agents/cli",
          "agents/mcp",
          "agents/skills"
        ]
      },
      {
        "group": "Recipes",
        "pages": ["recipes/meeting-prep"]
      },
      {
        "group": "Reference",
        "pages": [
          "reference/cli",
          "reference/mcp",
          "reference/errors"
        ]
      },
      {
        "group": "Help",
        "pages": ["troubleshooting"]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Notare",
          "href": "https://notare.dev",
          "icon": "house"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/abhi-wan-kenobi/notare",
          "icon": "github"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Roadmap",
        "href": "https://github.com/users/abhi-wan-kenobi/projects/1"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Download Notare",
      "href": "https://github.com/abhi-wan-kenobi/notare/releases/latest"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/abhi-wan-kenobi/notare"
    }
  }
}
